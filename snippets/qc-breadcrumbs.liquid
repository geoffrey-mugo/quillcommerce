{% doc %}
  Breadcrumbs (SPEC-010 A): labeled nav + matching BreadcrumbList JSON-LD.
  Renders per template context; current item is text with aria-current.
{% enddoc %}
{%- liquid
  assign crumb_url = blank
  assign crumb_label = blank
  assign current_label = blank

  case template.name
    when 'collection'
      assign current_label = collection.title
    when 'product'
      assign current_label = product.title
      if collection
        assign crumb_url = collection.url
        assign crumb_label = collection.title
      else
        assign crumb_url = routes.all_products_collection_url
        assign crumb_label = 'breadcrumbs.products' | t
      endif
    when 'page'
      assign current_label = page.title
    when 'article'
      assign current_label = article.title
      assign crumb_url = blog.url
      assign crumb_label = blog.title
  endcase
-%}
{%- if current_label != blank -%}
  <nav class="qc-breadcrumbs" aria-label="{{ 'breadcrumbs.label' | t }}">
    <ol class="qc-breadcrumbs__list" role="list">
      <li><a href="{{ routes.root_url }}">{{ 'breadcrumbs.home' | t }}</a></li>
      {%- if crumb_label != blank -%}
        <li><a href="{{ crumb_url }}">{{ crumb_label }}</a></li>
      {%- endif -%}
      <li><span aria-current="page">{{ current_label }}</span></li>
    </ol>
  </nav>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'breadcrumbs.home' | t | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
        {%- if crumb_label != blank -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ crumb_label | json }}, "item": {{ shop.url | append: crumb_url | json }} }
        ,{ "@type": "ListItem", "position": 3, "name": {{ current_label | json }} }
        {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ current_label | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
