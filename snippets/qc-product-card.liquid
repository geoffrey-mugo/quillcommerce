{% doc %}
  Canonical QuillCommerce product card, v1 (SPEC-004 §1). The single card
  used by collection, search, recommendations, and merchandising contexts.
  Phase 2 extends it (quick add) via the data hook without markup changes.

  @param {object} product - product object (required)
  @param {boolean} [show_vendor] - render vendor line above the title
{% enddoc %}
<article class="qc-product-card" data-qc-product-card="{{ product.handle }}">
  <a class="qc-product-card__link" href="{{ product.url }}">
    <div class="qc-product-card__media">
      {% if product.featured_image %}
        {% render 'image',
          image: product.featured_image,
          class: 'qc-product-card__image',
          width: 600,
          height: 600,
          crop: 'center'
        %}
      {% else %}
        <div class="qc-product-card__image qc-product-card__image--empty" aria-hidden="true">
          {% render 'qc-icon', name: 'alert' %}
        </div>
      {% endif %}
    </div>
    <div class="qc-product-card__body">
      {% if show_vendor and product.vendor != blank %}
        <p class="qc-text-s qc-muted">{{ product.vendor }}</p>
      {% endif %}
      <h3 class="qc-product-card__title">{{ product.title }}</h3>
    </div>
  </a>
  <div class="qc-product-card__footer">
    {% render 'qc-price', item: product %}
    {% unless product.available %}
      <span class="qc-badge">{{ 'products.product.sold_out' | t }}</span>
    {% endunless %}
  </div>
</article>
