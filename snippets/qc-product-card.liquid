{% doc %}
  Canonical QuillCommerce product card (SPEC-027 §6). Image-led: the media
  dominates, the info stack is condition metadata, title, price, and optional
  swatches, and purchase is a single disclosed entry — a direct add for
  single-variant products, or the shared options surface (quick view) for
  multi-variant — revealed on hover and keyboard focus, always shown on touch.
  No compare, quantity stepper, variant dropdown, or line total on the card.
  No-JS: the add posts natively; the options entry falls back to the product
  page. The single card used by collection, search, recommendations,
  recently-viewed, and merchandising contexts.

  @param {object} product - product object (required)
  @param {boolean} [show_vendor] - render vendor line above the title
{% enddoc %}
{%- liquid
  assign qc_v = product.selected_or_first_available_variant
  assign qc_preorder = false
  if qc_v.available and qc_v.inventory_management == 'shopify' and qc_v.inventory_policy == 'continue' and qc_v.inventory_quantity <= 0
    assign qc_preorder = true
  endif
  assign qc_kind = product.type | default: product.vendor
-%}
<article class="qc-product-card" data-qc-product-card="{{ product.handle }}">
  <div class="qc-product-card__media-wrap">
    <a class="qc-product-card__media-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      <div class="qc-product-card__media">
        {% render 'qc-product-badges', product: product %}
        {% if product.featured_image %}
          {% render 'image',
            image: product.featured_image,
            class: 'qc-product-card__image',
            width: 700,
            height: 875,
            crop: 'center',
            sizes: '(min-width: 990px) 340px, (min-width: 650px) 33vw, 50vw'
          %}
          {% if settings.enable_card_hover_image and product.images[1] %}
            {% render 'image',
              image: product.images[1],
              class: 'qc-product-card__image qc-product-card__image--hover',
              width: 700,
              height: 875,
              crop: 'center',
              sizes: '(min-width: 990px) 340px, (min-width: 650px) 33vw, 50vw'
            %}
          {% endif %}
        {% else %}
          <div class="qc-product-card__image qc-product-card__image--empty" aria-hidden="true">
            {% render 'qc-icon', name: 'alert' %}
          </div>
        {% endif %}
      </div>
    </a>

    {% if product.available %}
      <div class="qc-product-card__disclose">
        {% if product.has_only_default_variant %}
          <qc-product-form
            data-adding-label="{{ 'products.card.adding' | t }}"
            data-added-label="{{ 'products.card.added' | t: title: product.title }}"
            data-error-label="{{ 'products.card.add_error' | t }}"
          >
            <form action="{{ routes.cart_add_url }}" method="post">
              <input type="hidden" name="id" value="{{ qc_v.id }}">
              <button type="submit" class="qc-btn qc-product-card__action">
                {% if qc_preorder %}{{ 'products.product.preorder' | t }}{% else %}{{ 'products.card.quick_add' | t }}{% endif %}
                <span class="qc-visually-hidden">— {{ product.title }}</span>
              </button>
            </form>
          </qc-product-form>
        {% else %}
          <qc-quick-view
            data-loading-label="{{ 'products.quick_view.loading' | t }}"
            data-error-label="{{ 'products.quick_view.error' | t }}"
            data-close-label="{{ 'products.quick_view.close' | t }}"
            data-details-label="{{ 'products.quick_view.view_details' | t }}"
          >
            <a class="qc-btn qc-product-card__action" href="{{ product.url }}">
              {{ 'products.card.choose_options' | t }}
              <span class="qc-visually-hidden">— {{ product.title }}</span>
            </a>
          </qc-quick-view>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="qc-product-card__body">
    {% if show_vendor and product.vendor != blank %}
      <p class="qc-product-card__kind">{{ product.vendor }}</p>
    {% elsif qc_kind != blank %}
      <p class="qc-product-card__kind">{{ qc_kind }}</p>
    {% endif %}

    <h3 class="qc-product-card__title">
      <a class="qc-product-card__link" href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="qc-product-card__price">
      {% render 'qc-price', item: qc_v %}
      {%- unless product.available -%}
        <span class="qc-product-card__soldout">{{ 'products.product.sold_out' | t }}</span>
      {%- endunless -%}
    </div>

    {%- liquid
      assign qc_swatch_option = nil
      for qc_opt in product.options_with_values
        for qc_val in qc_opt.values
          if qc_val.swatch
            assign qc_swatch_option = qc_opt
            break
          endif
        endfor
        if qc_swatch_option
          break
        endif
      endfor
    -%}
    {% if qc_swatch_option %}
      <ul class="qc-product-card__swatches" role="list" aria-label="{{ qc_swatch_option.name }}">
        {% for qc_val in qc_swatch_option.values limit: 4 %}
          <li
            class="qc-swatch qc-swatch--dot"
            {% if qc_val.swatch.color %}style="--qc-swatch: {{ qc_val.swatch.color }}"{% endif %}
          >
            {%- if qc_val.swatch.image -%}
              {{ qc_val.swatch.image | image_url: width: 32 | image_tag: loading: 'lazy', alt: '' }}
            {%- endif -%}
            <span class="qc-visually-hidden">{{ qc_val }}</span>
          </li>
        {% endfor %}
        {% if qc_swatch_option.values.size > 4 %}
          <li class="qc-product-card__swatch-more">+{{ qc_swatch_option.values.size | minus: 4 }}</li>
        {% endif %}
      </ul>
    {% endif %}
  </div>
</article>
