{% doc %}
  One customer_address form (SPEC-022 §5), used for both new and edit.

  @param {object} [address] - existing address (omit for the new form)
  @param {string} id_prefix - unique prefix for input ids (required)
{% enddoc %}

{% form 'customer_address', address, class: 'qc-account__form' %}
  {% render 'qc-form-errors', form: form %}
  <div class="qc-account__form-row">
    <div class="qc-field">
      <label class="qc-field__label" for="{{ id_prefix }}-first">{{ 'customer.fields.first_name' | t }}</label>
      <input class="qc-input" id="{{ id_prefix }}-first" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
    </div>
    <div class="qc-field">
      <label class="qc-field__label" for="{{ id_prefix }}-last">{{ 'customer.fields.last_name' | t }}</label>
      <input class="qc-input" id="{{ id_prefix }}-last" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
    </div>
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-company">{{ 'customer.fields.company' | t }}</label>
    <input class="qc-input" id="{{ id_prefix }}-company" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-address1">{{ 'customer.fields.address1' | t }}</label>
    <input class="qc-input" id="{{ id_prefix }}-address1" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1">
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-address2">{{ 'customer.fields.address2' | t }}</label>
    <input class="qc-input" id="{{ id_prefix }}-address2" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
  </div>
  <div class="qc-account__form-row">
    <div class="qc-field">
      <label class="qc-field__label" for="{{ id_prefix }}-city">{{ 'customer.fields.city' | t }}</label>
      <input class="qc-input" id="{{ id_prefix }}-city" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2">
    </div>
    <div class="qc-field">
      <label class="qc-field__label" for="{{ id_prefix }}-zip">{{ 'customer.fields.zip' | t }}</label>
      <input class="qc-input" id="{{ id_prefix }}-zip" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code">
    </div>
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-country">{{ 'customer.fields.country' | t }}</label>
    <select class="qc-input" id="{{ id_prefix }}-country" name="address[country]" autocomplete="country-name" data-default="{{ form.country }}">
      {{ all_country_option_tags }}
    </select>
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-province">{{ 'customer.fields.province' | t }}</label>
    <input class="qc-input" id="{{ id_prefix }}-province" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
  </div>
  <div class="qc-field">
    <label class="qc-field__label" for="{{ id_prefix }}-phone">{{ 'customer.fields.phone' | t }}</label>
    <input class="qc-input" id="{{ id_prefix }}-phone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
  </div>
  <label class="qc-account__default-toggle">
    {{ form.set_as_default_checkbox }}
    <span>{{ 'customer.addresses.set_default' | t }}</span>
  </label>
  <button type="submit" class="qc-btn qc-btn--primary">
    {% if address %}{{ 'customer.addresses.save' | t }}{% else %}{{ 'customer.addresses.add' | t }}{% endif %}
  </button>
{% endform %}
