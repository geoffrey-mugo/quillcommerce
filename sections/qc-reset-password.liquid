{% comment %} Password reset (SPEC-022 §6). {% endcomment %}

<div class="qc-account section-padding">
  <h1>{{ 'customer.reset.title' | t }}</h1>
  {% comment %} email is a documented reset-template global {% endcomment %}
  {% # theme-check-disable UndefinedObject %}
  <p class="qc-muted">{{ 'customer.reset.hint' | t: email: email }}</p>
  {% # theme-check-enable UndefinedObject %}

  {% form 'reset_customer_password', class: 'qc-account__form' %}
    {% render 'qc-form-errors', form: form %}
    <div class="qc-field">
      <label class="qc-field__label" for="qc-reset-password">{{ 'customer.fields.password' | t }}</label>
      <input class="qc-input" id="qc-reset-password" type="password" name="customer[password]" autocomplete="new-password" required>
    </div>
    <div class="qc-field">
      <label class="qc-field__label" for="qc-reset-confirm">{{ 'customer.fields.password_confirm' | t }}</label>
      <input class="qc-input" id="qc-reset-confirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    </div>
    <button type="submit" class="qc-btn qc-btn--primary">{{ 'customer.reset.submit' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.reset_password",
  "settings": []
}
{% endschema %}
