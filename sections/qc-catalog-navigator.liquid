{% comment %}
  Catalog navigator (SPEC-010 C / SPEC-001 concept): collection blocks in
  tile or compact-list layout with optional product counts. Original
  QuillCommerce composition.
{% endcomment %}

<div class="qc-catnav section-padding">
  {% if section.settings.heading != blank %}
    <h2 class="qc-catnav__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% if section.blocks.size == 0 %}
    {% if request.design_mode %}
      <p class="qc-muted">{{ 'sections.catalog_navigator.editor_hint' | t }}</p>
    {% endif %}
  {% elsif section.settings.layout == 'list' %}
    <ul class="qc-catnav__list" role="list">
      {% for block in section.blocks %}
        {%- liquid
          assign target = block.settings.collection
          assign label = block.settings.title | default: target.title
          assign url = target.url | default: routes.all_products_collection_url
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="qc-catnav__list-link" href="{{ url }}">
            {{ label }}
            {% if section.settings.show_counts and target %}
              <span class="qc-muted">({{ target.all_products_count }})</span>
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <ul class="qc-catnav__tiles" role="list">
      {% for block in section.blocks %}
        {%- liquid
          assign target = block.settings.collection
          assign label = block.settings.title | default: target.title
          assign url = target.url | default: routes.all_products_collection_url
          assign tile_image = block.settings.image | default: target.featured_image
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="qc-catnav__tile" href="{{ url }}">
            <div class="qc-catnav__media">
              {% if tile_image %}
                {% render 'image', image: tile_image, class: 'qc-catnav__image', width: 600, height: 450, crop: 'center', sizes: '(min-width: 650px) 320px, 100vw' %}
              {% else %}
                <div class="qc-catnav__image qc-catnav__image--empty" aria-hidden="true">
                  <span>{{ label | slice: 0 }}</span>
                </div>
              {% endif %}
            </div>
            <span class="qc-catnav__label">
              {{ label }}
              {% if section.settings.show_counts and target %}
                <span class="qc-muted qc-text-s">({{ target.all_products_count }})</span>
              {% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>

{% stylesheet %}
  .qc-catnav {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-l);
    padding-block: var(--qc-space-xl);
  }

  .qc-catnav__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: var(--qc-space-m);
  }

  .qc-catnav__tile {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-xs);
    text-decoration: none;
    color: var(--qc-ink);
  }

  .qc-catnav__media {
    overflow: hidden;
    border-radius: var(--qc-radius-surface);
    border: var(--qc-line-w) solid var(--qc-line);
    background: var(--qc-surface-raised);
  }

  .qc-catnav__image {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform var(--qc-dur-2) var(--qc-ease);
  }

  .qc-catnav__tile:hover .qc-catnav__image {
    transform: scale(1.03);
  }

  .qc-catnav__image--empty {
    display: grid;
    place-items: center;
    font-family: var(--qc-font-display);
    font-size: var(--qc-text-3xl);
    color: var(--qc-line-strong);
    color: color-mix(in oklab, var(--qc-ink) 22%, var(--qc-surface));
  }

  .qc-catnav__label {
    font-weight: 600;
  }

  .qc-catnav__tile:hover .qc-catnav__label {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .qc-catnav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
    gap: 0 var(--qc-space-l);
  }

  .qc-catnav__list-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--qc-space-xs);
    min-block-size: 44px;
    text-decoration: none;
    color: var(--qc-ink);
    border-block-end: var(--qc-line-w) solid var(--qc-line);
  }

  .qc-catnav__list-link:hover {
    color: var(--qc-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.catalog_navigator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "Browse the catalog"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:general.layout",
      "default": "tiles",
      "options": [
        { "value": "tiles", "label": "t:general.layout_tiles" },
        { "value": "list", "label": "t:general.layout_list" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "t:general.show_counts",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:general.collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:general.collection" },
        { "type": "text", "id": "title", "label": "t:general.title_override" },
        { "type": "image_picker", "id": "image", "label": "t:general.image_override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.catalog_navigator",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
