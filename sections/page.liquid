{% comment %}
  Standard page (SPEC-004 §6): prose at measure width.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="qc-page">
  {% render 'qc-breadcrumbs' %}
  <h1>{{ page.title }}</h1>
  <div class="qc-prose">{{ page.content }}</div>
</div>

{% stylesheet %}
  .qc-page {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-l);
    padding-block: var(--qc-space-xl);
    max-inline-size: 46rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
