{% comment %}
  Guided loadout (SPEC-028): the proprietary mechanic. A use-case selector swaps
  a numbered, ordered set of products — one per system role — that work together,
  with one "Add loadout" action that resolves each item's variant and adds the
  whole set in a single cart request (reusing the SPEC-005 cart-updated / toast
  contract). Taxonomy is merchant-defined: the use-case axis and every role label
  are settings; products are merchant-selected per role, per use case.

  Progressive enhancement: every role item links to its product, so the loadout
  is fully browsable with no JS; the multi-add button is revealed only once the
  <qc-loadout> element upgrades.
{% endcomment %}

<section class="qc-loadout" aria-labelledby="qc-loadout-h-{{ section.id }}">
  <header class="qc-loadout__head">
    <div>
      {% if section.settings.eyebrow != blank %}
        <p class="qc-loadout__eyebrow qc-mono">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 id="qc-loadout-h-{{ section.id }}" class="qc-loadout__heading">{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.intro != blank %}
      <p class="qc-loadout__intro">{{ section.settings.intro }}</p>
    {% endif %}
  </header>

  <qc-loadout
    class="qc-loadout__app"
    data-add-url="{{ routes.cart_add_url }}"
    data-cart-url="{{ routes.cart_url }}"
    data-adding-label="{{ 'products.loadout.adding' | t }}"
    data-added-label="{{ 'products.loadout.added' | t }}"
    data-error-label="{{ 'products.loadout.error' | t }}"
  >
    {% if section.blocks.size > 1 %}
      <div class="qc-loadout__selector" role="tablist" aria-label="{{ section.settings.use_case_label }}">
        {% for block in section.blocks %}
          <button
            type="button"
            role="tab"
            id="qc-loadout-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="qc-loadout-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            class="qc-loadout__tab"
            data-qc-loadout-tab
          >
            <span class="qc-loadout__tab-axis qc-mono">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="qc-loadout__tab-name">{{ block.settings.use_case }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="qc-loadout__stage">
      {% for block in section.blocks %}
        {%- liquid
          assign total = 0
          assign piece_count = 0
          for i in (1..5)
            assign pkey = 'role_' | append: i | append: '_product'
            assign rp = block.settings[pkey]
            if rp != blank
              assign piece_count = piece_count | plus: 1
              assign total = total | plus: rp.price_min
            endif
          endfor
        -%}
        <div
          class="qc-loadout__panel"
          role="tabpanel"
          id="qc-loadout-panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="qc-loadout-tab-{{ section.id }}-{{ forloop.index }}"
          tabindex="0"
          data-qc-loadout-panel
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          {% if block.settings.summary != blank %}
            <p class="qc-loadout__panel-note qc-editorial">{{ block.settings.summary }}</p>
          {% endif %}

          <ol class="qc-loadout__roles">
            {%- assign pos = 0 -%}
            {% for i in (1..5) %}
              {%- liquid
                assign pkey = 'role_' | append: i | append: '_product'
                assign lkey = 'role_' | append: i | append: '_label'
                assign prod = block.settings[pkey]
              -%}
              {% if prod != blank %}
                {%- liquid
                  assign pos = pos | plus: 1
                  assign rlabel = section.settings[lkey]
                  assign v = prod.selected_or_first_available_variant
                -%}
                <li class="qc-loadout__role{% unless prod.available %} qc-loadout__role--out{% endunless %}">
                  <div class="qc-loadout__role-tag">
                    <span class="qc-loadout__role-num qc-mono">{{ pos | prepend: '0' | slice: -2, 2 }}</span>
                    <span class="qc-loadout__role-label qc-mono">{{ rlabel | default: prod.type }}</span>
                  </div>

                  <a class="qc-loadout__thumb" href="{{ prod.url }}" tabindex="-1" aria-hidden="true">
                    {% if prod.featured_image %}
                      {{ prod.featured_image | image_url: width: 320 | image_tag: class: 'qc-loadout__thumb-img', alt: '', loading: 'lazy', widths: '160, 240, 320', sizes: '96px' }}
                    {% else %}
                      <span class="qc-loadout__thumb-img qc-loadout__thumb-img--empty" aria-hidden="true"></span>
                    {% endif %}
                  </a>

                  <div class="qc-loadout__role-body">
                    <a class="qc-loadout__role-title" href="{{ prod.url }}">{{ prod.title }}</a>
                    <span class="qc-loadout__role-price">
                      {% render 'qc-price', item: v %}
                      {%- unless prod.available %} <span class="qc-loadout__soldout qc-mono">{{ 'products.product.sold_out' | t }}</span>{% endunless -%}
                    </span>
                  </div>

                  <div class="qc-loadout__role-pick">
                    {% if prod.available %}
                      {% if prod.variants.size > 1 %}
                        <select class="qc-loadout__variant" data-qc-loadout-variant aria-label="{{ prod.title | escape }} — {{ prod.options_with_values.first.name | escape }}">
                          {% for variant in prod.variants %}
                            <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant.id == v.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                              {{ variant.title }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
                            </option>
                          {% endfor %}
                        </select>
                      {% else %}
                        <input type="hidden" data-qc-loadout-variant value="{{ v.id }}" data-price="{{ v.price }}">
                      {% endif %}
                    {% endif %}
                  </div>
                </li>
              {% endif %}
            {% endfor %}
          </ol>

          <div class="qc-loadout__summary">
            <div class="qc-loadout__summary-figure">
              <span class="qc-loadout__summary-label qc-mono">{{ 'products.loadout.total' | t }}</span>
              <span class="qc-loadout__summary-total">
                <span class="qc-mono qc-loadout__from">{{ 'products.loadout.from' | t }}</span>
                {{ total | money }}
                <span class="qc-loadout__pieces qc-mono">{{ 'products.loadout.pieces' | t: count: piece_count }}</span>
              </span>
            </div>
            <button type="button" class="qc-btn qc-loadout__add" data-qc-loadout-add hidden>
              {{ section.settings.add_label | default: 'Add loadout' }}
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
  </qc-loadout>
</section>

{% stylesheet %}
  .qc-loadout {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-xl);
    padding-block: var(--qc-space-2xl);
  }

  .qc-loadout__head { display: grid; gap: var(--qc-space-m); align-items: end; }
  @media (min-width: 800px) {
    .qc-loadout__head { grid-template-columns: 1fr auto; }
    .qc-loadout__intro { text-align: end; }
  }

  .qc-loadout__eyebrow {
    margin: 0 0 var(--qc-space-xs);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--qc-accent);
  }
  .qc-loadout__heading { margin: 0; font-size: var(--qc-text-2xl); letter-spacing: -0.01em; }
  .qc-loadout__intro { margin: 0; color: var(--qc-ink-soft); max-inline-size: 44ch; }

  /* selector: a hard-ruled field switch, not pills */
  .qc-loadout__selector {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border: var(--qc-line-w) solid var(--qc-line-strong);
  }
  .qc-loadout__tab {
    flex: 1 1 auto;
    display: flex;
    align-items: baseline;
    gap: var(--qc-space-xs);
    padding: var(--qc-space-s) var(--qc-space-m);
    background: transparent;
    border: 0;
    border-inline-start: var(--qc-line-w) solid var(--qc-line-strong);
    cursor: pointer;
    color: var(--qc-ink-soft);
    font: inherit;
    text-align: start;
    transition: background var(--qc-dur-1) var(--qc-ease), color var(--qc-dur-1) var(--qc-ease);
  }
  .qc-loadout__tab:first-child { border-inline-start: 0; }
  .qc-loadout__tab-axis { font-size: 0.68rem; letter-spacing: 0.12em; color: var(--qc-line-strong); }
  .qc-loadout__tab-name { font-family: var(--qc-font-display); font-weight: 600; font-size: var(--qc-text-m); letter-spacing: -0.01em; }
  .qc-loadout__tab:hover { color: var(--qc-ink); }
  .qc-loadout__tab[aria-selected="true"] { background: var(--qc-ink); color: var(--qc-surface); }
  .qc-loadout__tab[aria-selected="true"] .qc-loadout__tab-axis { color: var(--qc-accent); }

  .qc-loadout__panel[hidden] { display: none; }
  .qc-loadout__panel:focus-visible { outline: none; }

  .qc-loadout__panel-note {
    margin: 0 0 var(--qc-space-l);
    font-size: var(--qc-text-l);
    line-height: 1.3;
    max-inline-size: 46ch;
  }

  .qc-loadout__roles {
    list-style: none;
    margin: 0;
    padding: 0;
    border-block-start: var(--qc-line-w) solid var(--qc-line);
  }

  .qc-loadout__role {
    display: grid;
    grid-template-columns: auto 88px 1fr;
    grid-template-areas: "tag thumb body" "pick pick pick";
    align-items: center;
    gap: var(--qc-space-s) var(--qc-space-m);
    padding-block: var(--qc-space-m);
    border-block-end: var(--qc-line-w) solid var(--qc-line);
  }

  @media (min-width: 720px) {
    .qc-loadout__role {
      grid-template-columns: 132px 88px minmax(0, 1fr) minmax(0, 16rem);
      grid-template-areas: "tag thumb body pick";
      gap: var(--qc-space-l);
    }
  }

  .qc-loadout__role--out { opacity: 0.62; }

  .qc-loadout__role-tag { grid-area: tag; display: flex; flex-direction: column; gap: 0.2rem; }
  .qc-loadout__role-num { font-size: 0.7rem; letter-spacing: 0.1em; color: var(--qc-accent); }
  .qc-loadout__role-label {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--qc-font-display);
    font-weight: 600;
    color: var(--qc-ink);
  }

  .qc-loadout__thumb {
    grid-area: thumb;
    display: block;
    inline-size: 88px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--qc-surface-raised);
  }
  .qc-loadout__thumb-img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
  .qc-loadout__thumb-img--empty { background: var(--qc-surface-raised); }

  .qc-loadout__role-body { grid-area: body; display: flex; flex-direction: column; gap: 0.25rem; min-inline-size: 0; }
  .qc-loadout__role-title {
    font-family: var(--qc-font-display);
    font-weight: 500;
    font-size: var(--qc-text-m);
    letter-spacing: -0.005em;
    text-decoration: none;
    color: inherit;
  }
  .qc-loadout__role-title:hover { color: var(--qc-accent); }
  .qc-loadout__role-price { display: flex; align-items: baseline; gap: var(--qc-space-xs); }
  .qc-loadout__role-price .qc-price { font-family: var(--qc-font-mono); font-size: var(--qc-text-s); font-weight: 500; }
  .qc-loadout__soldout { font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--qc-ink-soft); }

  .qc-loadout__role-pick { grid-area: pick; }
  .qc-loadout__variant {
    inline-size: 100%;
    min-block-size: 44px;
    padding: 0 var(--qc-space-m);
    font: inherit;
    font-size: var(--qc-text-s);
    color: var(--qc-ink);
    background: var(--qc-surface);
    border: var(--qc-line-w) solid var(--qc-line-strong);
    border-radius: var(--qc-radius-control);
  }

  .qc-loadout__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--qc-space-m);
    padding-block-start: var(--qc-space-l);
  }
  .qc-loadout__summary-label { display: block; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--qc-ink-soft); margin-block-end: 0.2rem; }
  .qc-loadout__summary-total { display: flex; align-items: baseline; gap: var(--qc-space-xs); font-family: var(--qc-font-display); font-weight: 600; font-size: var(--qc-text-xl); }
  .qc-loadout__from { font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--qc-ink-soft); font-weight: 400; }
  .qc-loadout__pieces { font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--qc-ink-soft); font-weight: 400; }

  .qc-loadout__add.qc-btn {
    background: var(--qc-signal);
    color: var(--qc-signal-ink);
    border: 0;
    min-block-size: 50px;
    padding-inline: var(--qc-space-xl);
    font-weight: var(--qc-font-display-weight);
    letter-spacing: 0.01em;
  }
  .qc-loadout__add.qc-btn:hover { background: color-mix(in oklab, var(--qc-signal) 88%, #000); color: var(--qc-signal-ink); }
  .qc-loadout__add[aria-busy="true"] { opacity: 0.7; }

  .qc-loadout__error { flex-basis: 100%; margin: 0; color: var(--qc-danger); font-size: var(--qc-text-s); }

  @media (prefers-reduced-motion: reduce) {
    .qc-loadout__tab { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:home.loadout",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:home.eyebrow", "default": "Guided loadout" },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Build your kit for the day" },
    { "type": "textarea", "id": "intro", "label": "t:home.intro", "default": "Pick the conditions. We compose the layers that work together." },
    { "type": "text", "id": "use_case_label", "label": "t:home.use_case_label", "default": "Condition", "info": "t:home.use_case_label_info" },
    { "type": "text", "id": "add_label", "label": "t:home.add_label", "default": "Add loadout" },
    { "type": "header", "content": "t:home.roles" },
    { "type": "text", "id": "role_1_label", "label": "t:home.role_n_label", "default": "Base" },
    { "type": "text", "id": "role_2_label", "label": "t:home.role_n_label", "default": "Mid" },
    { "type": "text", "id": "role_3_label", "label": "t:home.role_n_label", "default": "Shell" },
    { "type": "text", "id": "role_4_label", "label": "t:home.role_n_label", "default": "Pack" },
    { "type": "text", "id": "role_5_label", "label": "t:home.role_n_label", "default": "Accessory" }
  ],
  "blocks": [
    {
      "type": "loadout",
      "name": "t:home.use_case",
      "settings": [
        { "type": "text", "id": "use_case", "label": "t:home.use_case", "default": "Cold water" },
        { "type": "textarea", "id": "summary", "label": "t:home.summary" },
        { "type": "product", "id": "role_1_product", "label": "t:home.role_n_product" },
        { "type": "product", "id": "role_2_product", "label": "t:home.role_n_product" },
        { "type": "product", "id": "role_3_product", "label": "t:home.role_n_product" },
        { "type": "product", "id": "role_4_product", "label": "t:home.role_n_product" },
        { "type": "product", "id": "role_5_product", "label": "t:home.role_n_product" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "t:home.loadout" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
