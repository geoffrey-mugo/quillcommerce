{% comment %}
  Featured product: spotlight one product on any sectioned template, with
  a working purchase form and app-block support.
  https://shopify.dev/docs/storefronts/themes/architecture/sections
{% endcomment %}

{% liquid
  assign product = section.settings.product
  assign fp_variant = product.selected_or_first_available_variant
  assign fp_form_id = 'qc-featured-form-' | append: section.id
%}

<div class="qc-featured-product section-padding">
  <div class="qc-featured-product__media">
    {% if product.featured_media %}
      {% render 'image', image: product.featured_media, class: 'qc-featured-product__image', width: 900 %}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'qc-featured-product__placeholder' }}
    {% endif %}
  </div>

  <div class="qc-featured-product__info">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when '@app' %}
          {% render block %}

        {% when 'title' %}
          {% if product != blank %}
            <h2 class="qc-featured-product__title" {{ block.shopify_attributes }}>
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h2>
          {% else %}
            <h2 class="qc-featured-product__title" {{ block.shopify_attributes }}>
              {{ 'products.card.example_title' | t }}
            </h2>
          {% endif %}

        {% when 'price' %}
          {% if product != blank %}
            <div class="qc-price" {{ block.shopify_attributes }}>
              {% if fp_variant.compare_at_price > fp_variant.price %}
                <span class="qc-visually-hidden">{{ 'products.price.sale_price' | t }}</span>
                <span>{{ fp_variant.price | money }}</span>
                <s class="qc-price__compare">{{ fp_variant.compare_at_price | money }}</s>
              {% else %}
                <span>{{ fp_variant.price | money }}</span>
              {% endif %}
            </div>
          {% endif %}

        {% when 'description' %}
          {% if product.description != blank %}
            <div class="qc-prose qc-featured-product__description" {{ block.shopify_attributes }}>
              {{ product.description | strip_html | truncatewords: 40 }}
            </div>
          {% endif %}

        {% when 'buy_buttons' %}
          {% if product != blank %}
            <qc-product-form
              data-adding-label="{{ 'products.card.adding' | t }}"
              data-added-label="{{ 'products.card.added' | t: title: product.title }}"
              data-error-label="{{ 'products.card.add_error' | t }}"
              {{ block.shopify_attributes }}
            >
              {% form 'product', product, id: fp_form_id %}
                {% if product.has_only_default_variant %}
                  <input type="hidden" name="id" value="{{ fp_variant.id }}">
                {% else %}
                  <div class="qc-field">
                    <label class="qc-field__label" for="qc-featured-variant-{{ section.id }}">
                      {{ 'products.product.options_label' | t }}
                    </label>
                    <select id="qc-featured-variant-{{ section.id }}" name="id">
                      {% for variant in product.variants %}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == fp_variant %}selected="selected"{% endif %}
                          {% unless variant.available %}disabled{% endunless %}
                        >
                          {{ variant.title }} — {{ variant.price | money }}
                          {%- unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless %}
                        </option>
                      {% endfor %}
                    </select>
                  </div>
                {% endif %}
                <button
                  type="submit"
                  class="qc-btn qc-btn--primary qc-btn--full"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ 'products.product.add_to_cart' | t }}
                  {% else %}
                    {{ 'products.product.sold_out' | t }}
                  {% endif %}
                </button>
                {{ form | payment_button }}
              {% endform %}
            </qc-product-form>
          {% endif %}

        {% when 'custom_liquid' %}
          <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .qc-featured-product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--qc-space-xl);
    align-items: start;
    padding-block: var(--qc-space-xl);
  }

  @media (max-width: 749px) {
    .qc-featured-product {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .qc-featured-product__image,
  .qc-featured-product__placeholder {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--qc-radius-surface);
  }

  .qc-featured-product__placeholder {
    background: var(--qc-surface-raised);
    aspect-ratio: 4 / 3;
  }

  .qc-featured-product__info {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
  }

  .qc-featured-product__title {
    margin: 0;
    font-size: var(--qc-text-2xl);
  }

  .qc-featured-product__title a {
    color: inherit;
    text-decoration: none;
  }

  .qc-featured-product__title a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_product",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "t:general.block_title", "limit": 1 },
    { "type": "price", "name": "t:general.block_price", "limit": 1 },
    { "type": "description", "name": "t:general.block_description", "limit": 1 },
    { "type": "buy_buttons", "name": "t:general.block_buy_buttons", "limit": 1 },
    {
      "type": "custom_liquid",
      "name": "t:general.custom_liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:general.custom_liquid",
          "info": "t:general.custom_liquid_info"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:general.product"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_product",
      "blocks": [
        { "type": "title" },
        { "type": "price" },
        { "type": "description" },
        { "type": "buy_buttons" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
