{% comment %}
  Hero banner (SPEC-020 §1): optional cover image with contrast overlay,
  heading/subheading, up to two CTAs. Pure Liquid — no JS.
{% endcomment %}

{%- liquid
  assign has_image = false
  if section.settings.image
    assign has_image = true
  endif
-%}

<div
  class="qc-hero full-width qc-hero--{{ section.settings.height }} qc-hero--{{ section.settings.alignment }}{% if has_image %} qc-hero--image{% endif %}"
  {% if has_image %}style="--qc-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"{% endif %}
>
  {% if has_image %}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag: class: 'qc-hero__image', alt: '', loading: 'eager', fetchpriority: 'high', sizes: '100vw'
    }}
  {% endif %}

  <div class="qc-hero__content">
    {% if section.settings.heading != blank %}
      {% if section.settings.heading_is_h1 %}
        <h1 class="qc-hero__heading">{{ section.settings.heading }}</h1>
      {% else %}
        <h2 class="qc-hero__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="qc-hero__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    {% if section.settings.cta_1_label != blank or section.settings.cta_2_label != blank %}
      <div class="qc-hero__actions">
        {% if section.settings.cta_1_label != blank %}
          <a class="qc-btn qc-btn--primary" href="{{ section.settings.cta_1_link | default: '#' }}">
            {{ section.settings.cta_1_label }}
          </a>
        {% endif %}
        {% if section.settings.cta_2_label != blank %}
          <a class="qc-btn qc-btn--outline qc-hero__cta-outline" href="{{ section.settings.cta_2_link | default: '#' }}">
            {{ section.settings.cta_2_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .qc-hero {
    position: relative;
    display: grid;
    align-items: center;
    overflow: hidden;
    background: var(--qc-surface-raised);
  }

  .qc-hero--small { min-block-size: 320px; }
  .qc-hero--medium { min-block-size: 440px; }
  .qc-hero--large { min-block-size: 70vb; }

  .qc-hero__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .qc-hero--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--qc-hero-overlay, 0.35));
  }

  .qc-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    padding: var(--qc-space-2xl) var(--qc-space-xl);
    max-inline-size: 46rem;
    justify-self: start;
    align-items: flex-start;
    text-align: start;
  }

  .qc-hero--center .qc-hero__content {
    justify-self: center;
    align-items: center;
    text-align: center;
  }

  .qc-hero--image .qc-hero__content {
    color: #fff;
  }

  .qc-hero__heading {
    margin: 0;
    font-size: var(--qc-text-3xl);
  }

  .qc-hero__subheading {
    margin: 0;
    font-size: var(--qc-text-l);
    max-inline-size: var(--qc-measure);
  }

  .qc-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--qc-space-s);
  }

  .qc-hero--image .qc-hero__cta-outline {
    border-color: #fff;
    color: #fff;
  }

  .qc-hero--image .qc-hero__cta-outline:hover {
    border-color: #fff;
    color: #fff;
    background: rgb(255 255 255 / 15%);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:general.image" },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:general.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Tell your story" },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "t:general.heading_is_h1",
      "info": "t:general.heading_is_h1_info",
      "default": false
    },
    { "type": "textarea", "id": "subheading", "label": "t:general.subheading" },
    { "type": "text", "id": "cta_1_label", "label": "t:general.cta_1_label", "default": "Shop now" },
    { "type": "url", "id": "cta_1_link", "label": "t:general.cta_1_link" },
    { "type": "text", "id": "cta_2_label", "label": "t:general.cta_2_label" },
    { "type": "url", "id": "cta_2_link", "label": "t:general.cta_2_link" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:general.alignment",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "center", "label": "t:general.align_center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:general.height",
      "options": [
        { "value": "small", "label": "t:general.height_small" },
        { "value": "medium", "label": "t:general.height_medium" },
        { "value": "large", "label": "t:general.height_large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [{ "name": "t:general.hero" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
