{% comment %} Account overview: orders + addresses link (SPEC-022 §3). {% endcomment %}

<div class="qc-account section-padding">
  <div class="qc-account__head">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a class="qc-btn qc-btn--quiet" href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t }}</a>
  </div>
  {% assign qc_customer_name = customer.first_name | default: customer.email %}
  <p>{{ 'customer.account.greeting' | t: name: qc_customer_name }}</p>

  <h2>{{ 'customer.account.orders' | t }}</h2>
  {% paginate customer.orders by 10 %}
    {% if customer.orders.size > 0 %}
      <div class="qc-account__table-scroll">
        <table class="qc-account__table">
          <caption class="qc-visually-hidden">{{ 'customer.account.orders' | t }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ 'customer.orders.number' | t }}</th>
              <th scope="col">{{ 'customer.orders.date' | t }}</th>
              <th scope="col">{{ 'customer.orders.payment' | t }}</th>
              <th scope="col">{{ 'customer.orders.fulfillment' | t }}</th>
              <th scope="col">{{ 'customer.orders.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for order in customer.orders %}
              <tr>
                <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                <td>{{ order.financial_status_label }}</td>
                <td>{{ order.fulfillment_status_label }}</td>
                <td>{{ order.total_net_amount | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if paginate.pages > 1 %}
        <nav class="qc-pagination" aria-label="{{ 'general.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% else %}
      <p class="qc-muted">{{ 'customer.orders.none' | t }}</p>
    {% endif %}
  {% endpaginate %}

  <div class="qc-account__links">
    <a href="{{ routes.account_addresses_url }}">
      {{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:general.account",
  "settings": []
}
{% endschema %}
