{% comment %}
  404 page (SPEC-004 §7).
  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

<div class="qc-404">
  <h1>{{ '404.title' | t }}</h1>
  <p class="qc-muted">{{ '404.not_found' | t }}</p>
  <a class="qc-btn qc-btn--primary" href="{{ routes.all_products_collection_url }}">
    {{ '404.back_to_shopping' | t }}
  </a>
</div>

{% stylesheet %}
  .qc-404 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--qc-space-m);
    padding-block: var(--qc-space-3xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
