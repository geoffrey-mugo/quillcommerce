{% comment %} Order detail (SPEC-022 §4). {% endcomment %}

<div class="qc-account section-padding">
  <div class="qc-account__links">
    <a href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a>
  </div>
  <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
  <p class="qc-muted">{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
  {% if order.cancelled %}
    <p class="qc-account__notice" role="status">
      {% render 'qc-icon', name: 'alert' %}
      {{ 'customer.order.cancelled' | t: date: order.cancelled_at | time_tag: format: 'date' }}
    </p>
  {% endif %}

  <div class="qc-account__table-scroll">
    <table class="qc-account__table">
      <caption class="qc-visually-hidden">{{ 'customer.order.items' | t }}</caption>
      <thead>
        <tr>
          <th scope="col">{{ 'customer.order.product' | t }}</th>
          <th scope="col">{{ 'customer.order.sku' | t }}</th>
          <th scope="col">{{ 'customer.order.quantity' | t }}</th>
          <th scope="col">{{ 'customer.order.line_total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for line_item in order.line_items %}
          <tr>
            <td>
              {% if line_item.url %}
                <a href="{{ line_item.url }}">{{ line_item.title }}</a>
              {% else %}
                {{ line_item.title }}
              {% endif %}
              {% for discount_allocation in line_item.line_level_discount_allocations %}
                <p class="qc-badge qc-badge--accent">
                  {{ discount_allocation.discount_application.title }}
                  (−{{ discount_allocation.amount | money }})
                </p>
              {% endfor %}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <th scope="row" colspan="3">{{ 'cart.subtotal' | t: count: order.item_count }}</th>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        {% for discount_application in order.cart_level_discount_applications %}
          <tr>
            <th scope="row" colspan="3">{{ discount_application.title }}</th>
            <td>−{{ discount_application.total_allocated_amount | money }}</td>
          </tr>
        {% endfor %}
        {% for shipping_method in order.shipping_methods %}
          <tr>
            <th scope="row" colspan="3">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</th>
            <td>{{ shipping_method.price | money }}</td>
          </tr>
        {% endfor %}
        {% for tax_line in order.tax_lines %}
          <tr>
            <th scope="row" colspan="3">{{ tax_line.title }} ({{ tax_line.rate | times: 100 }}%)</th>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {% endfor %}
        <tr>
          <th scope="row" colspan="3">{{ 'customer.order.total' | t }}</th>
          <td><strong>{{ order.total_net_amount | money }}</strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="qc-account__addresses">
    {% if order.billing_address %}
      <div>
        <h2>{{ 'customer.order.billing' | t }}</h2>
        <p class="qc-muted">{{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>
    {% endif %}
    {% if order.shipping_address %}
      <div>
        <h2>{{ 'customer.order.shipping_address' | t }}</h2>
        <p class="qc-muted">{{ order.fulfillment_status_label }}</p>
        {{ order.shipping_address | format_address }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:general.order",
  "settings": []
}
{% endschema %}
