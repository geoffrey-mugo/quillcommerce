{% comment %}
  Recently viewed products (SPEC-018). Two-phase: the page request emits
  only a <qc-recently-viewed> placeholder; the element reads its local
  history and fetches this same section through the search route with an
  id: OR query — that render (search.performed) emits the card grid.
{% endcomment %}

{% if search.performed %}
  {% if search.results.size > 0 %}
    <section class="qc-recs" aria-labelledby="qc-recent-heading-{{ section.id }}">
      <h2 id="qc-recent-heading-{{ section.id }}" class="qc-recs__heading">
        {{ section.settings.heading }}
      </h2>
      <ul class="qc-product-grid" role="list">
        {% for result in search.results %}
          {% if result.object_type == 'product' %}
            <li>
              {% render 'qc-product-card', product: result %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  {% endif %}
{% else %}
  <qc-recently-viewed
    data-search-url="{{ routes.search_url }}"
    data-section-id="{{ section.id }}"
    data-limit="{{ section.settings.limit }}"
    {% if product %}data-exclude="{{ product.id }}"{% endif %}
  ></qc-recently-viewed>
  <script src="{{ 'qc-recently-viewed.js' | asset_url }}" type="module"></script>
{% endif %}

{% schema %}
{
  "name": "t:general.recently_viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:general.heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:general.max_products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:general.recently_viewed"
    }
  ]
}
{% endschema %}
