{% comment %}
  Slideshow (SPEC-024 §2): scroll-snap slide track that works without
  JS; the qc-slideshow element adds arrows, dots, loop, and optional
  autoplay (paused on hover/focus, never under reduced motion).
{% endcomment %}

<script src="{{ 'qc-slideshow.js' | asset_url }}" type="module"></script>

<qc-slideshow
  class="qc-slideshow full-width qc-slideshow--{{ section.settings.height }} qc-slideshow--{{ section.settings.alignment }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ 'slideshow.label' | t }}"
  data-autoplay="{{ section.settings.autoplay }}"
  style="--qc-hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  <div class="qc-slideshow__track" data-qc-track>
    {% for block in section.blocks %}
      <div class="qc-slideshow__slide" data-qc-slide {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          {% liquid
            assign slide_loading = 'lazy'
            assign slide_priority = nil
            if forloop.first
              assign slide_loading = 'eager'
              assign slide_priority = 'high'
            endif
          %}
          {% if slide_priority %}
            {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'qc-slideshow__image', alt: '', loading: slide_loading, fetchpriority: slide_priority, sizes: '100vw' }}
          {% else %}
            {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'qc-slideshow__image', alt: '', loading: slide_loading, sizes: '100vw' }}
          {% endif %}
          <div class="qc-slideshow__scrim" aria-hidden="true"></div>
        {% endif %}
        <div class="qc-slideshow__content">
          {% if block.settings.heading != blank %}
            {% if forloop.first and section.settings.heading_is_h1 %}
              <h1 class="qc-slideshow__heading">{{ block.settings.heading }}</h1>
            {% else %}
              <h2 class="qc-slideshow__heading">{{ block.settings.heading }}</h2>
            {% endif %}
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="qc-slideshow__subheading">{{ block.settings.subheading }}</p>
          {% endif %}
          {% if block.settings.cta_label != blank %}
            <a class="qc-btn qc-btn--primary" href="{{ block.settings.cta_link | default: '#' }}">
              {{ block.settings.cta_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="qc-slideshow__controls" data-qc-controls hidden>
      <button type="button" class="qc-btn qc-slideshow__arrow" data-qc-prev aria-label="{{ 'slideshow.previous' | t }}">
        {% render 'qc-icon', name: 'chevron' %}
      </button>
      <div class="qc-slideshow__dots" role="group" aria-label="{{ 'slideshow.label' | t }}">
        {% for block in section.blocks %}
          <button
            type="button"
            class="qc-slideshow__dot"
            data-qc-dot="{{ forloop.index0 }}"
            aria-label="{{ 'slideshow.slide_n' | t: n: forloop.index, total: section.blocks.size }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        {% endfor %}
      </div>
      <button type="button" class="qc-btn qc-slideshow__arrow qc-slideshow__arrow--next" data-qc-next aria-label="{{ 'slideshow.next' | t }}">
        {% render 'qc-icon', name: 'chevron' %}
      </button>
    </div>
  {% endif %}
</qc-slideshow>

{% stylesheet %}
  .qc-slideshow {
    position: relative;
    background: var(--qc-surface-raised);
  }

  .qc-slideshow__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .qc-slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .qc-slideshow__slide {
    position: relative;
    flex: 0 0 100%;
    display: grid;
    align-items: center;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .qc-slideshow--small .qc-slideshow__slide { min-block-size: 320px; }
  .qc-slideshow--medium .qc-slideshow__slide { min-block-size: 440px; }
  .qc-slideshow--large .qc-slideshow__slide { min-block-size: 70vb; }

  .qc-slideshow__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .qc-slideshow__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / var(--qc-hero-overlay, 0.35));
  }

  .qc-slideshow__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    padding: var(--qc-space-2xl) var(--qc-space-xl);
    max-inline-size: 46rem;
    justify-self: start;
    align-items: flex-start;
    text-align: start;
  }

  .qc-slideshow--center .qc-slideshow__content {
    justify-self: center;
    align-items: center;
    text-align: center;
  }

  .qc-slideshow__slide:has(.qc-slideshow__image) .qc-slideshow__content {
    color: #fff;
  }

  .qc-slideshow__heading {
    margin: 0;
    font-size: var(--qc-text-3xl);
  }

  .qc-slideshow__subheading {
    margin: 0;
    font-size: var(--qc-text-l);
    max-inline-size: var(--qc-measure);
  }

  .qc-slideshow__controls {
    position: absolute;
    inset-inline: 0;
    inset-block-end: var(--qc-space-m);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--qc-space-m);
  }

  .qc-slideshow__arrow {
    min-block-size: 44px;
    min-inline-size: 44px;
    padding: 0;
    background: var(--qc-surface);
    border: var(--qc-line-w) solid var(--qc-line-strong);
    border-radius: var(--qc-radius-pill);
  }

  .qc-slideshow__arrow svg {
    transform: rotate(90deg);
  }

  .qc-slideshow__arrow--next svg {
    transform: rotate(-90deg);
  }

  .qc-slideshow__dots {
    display: flex;
    gap: var(--qc-space-xs);
  }

  .qc-slideshow__dot {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    padding: 0;
    border: var(--qc-line-w) solid var(--qc-surface);
    border-radius: var(--qc-radius-pill);
    background: transparent;
    cursor: pointer;
  }

  .qc-slideshow__dot[aria-current='true'] {
    background: var(--qc-surface);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "overlay",
      "label": "t:general.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "heading_is_h1",
      "label": "t:general.heading_is_h1",
      "info": "t:general.heading_is_h1_info",
      "default": false
    },
    {
      "type": "select",
      "id": "autoplay",
      "label": "t:general.autoplay",
      "options": [
        { "value": "0", "label": "t:general.autoplay_off" },
        { "value": "3", "label": "t:general.autoplay_3" },
        { "value": "5", "label": "t:general.autoplay_5" },
        { "value": "8", "label": "t:general.autoplay_8" }
      ],
      "default": "0"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:general.alignment",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "center", "label": "t:general.align_center" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:general.height",
      "options": [
        { "value": "small", "label": "t:general.height_small" },
        { "value": "medium", "label": "t:general.height_medium" },
        { "value": "large", "label": "t:general.height_large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:general.slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:general.image" },
        { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Slide heading" },
        { "type": "textarea", "id": "subheading", "label": "t:general.subheading" },
        { "type": "text", "id": "cta_label", "label": "t:general.cta_1_label" },
        { "type": "url", "id": "cta_link", "label": "t:general.cta_1_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
