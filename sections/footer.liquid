{% comment %}
  Footer (SPEC-029 §3): an editorial composition, not a mirror of the header.
  Large wordmark + closing statement, an integrated newsletter, grouped
  navigation columns (blocks), factual service text, and a thin mono terminal
  rail for legal / region / payments. Shares the header's type, rules, and
  field-index language.
{% endcomment %}

<footer class="qc-footer full-width">
  <div class="qc-footer__inner">
    <div class="qc-footer__masthead">
      <div class="qc-footer__brand">
        <p class="qc-footer__wordmark">{{ settings.brand_name | default: shop.name }}</p>
        {% if section.settings.closing != blank %}
          <p class="qc-footer__closing qc-editorial">{{ section.settings.closing }}</p>
        {% endif %}
        {% render 'qc-social' %}
      </div>

      {% if section.settings.show_newsletter %}
        <div class="qc-footer__signup">
          {% if section.settings.newsletter_heading != blank %}
            <p class="qc-footer__signup-label qc-mono">{{ section.settings.newsletter_heading }}</p>
          {% endif %}
          {% form 'customer', class: 'qc-footer__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="qc-visually-hidden" for="qc-footer-email">{{ 'newsletter.email_label' | t }}</label>
            <div class="qc-footer__field">
              <input
                id="qc-footer-email"
                class="qc-footer__input"
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                placeholder="{{ 'newsletter.email_placeholder' | t }}"
              >
              <button type="submit" class="qc-footer__submit">{{ 'newsletter.submit' | t }}</button>
            </div>
            {% if form.posted_successfully? %}
              <p class="qc-footer__note" role="status">{{ 'newsletter.success' | t }}</p>
            {% endif %}
          {% endform %}
          {% if section.settings.newsletter_text != blank %}
            <p class="qc-footer__signup-note">{{ section.settings.newsletter_text }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="qc-footer__cols">
      {% for block in section.blocks %}
        <nav class="qc-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
          <p class="qc-footer__col-head qc-mono">
            <span class="qc-footer__col-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {{ block.settings.heading }}
          </p>
          {% if block.settings.menu != blank %}
            <ul class="qc-footer__col-links" role="list">
              {% for link in block.settings.menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </nav>
      {% endfor %}

      {% if section.settings.service_text != blank %}
        <div class="qc-footer__col qc-footer__service">
          {% if section.settings.service_heading != blank %}
            <p class="qc-footer__col-head qc-mono"><span class="qc-footer__col-index">·</span>{{ section.settings.service_heading }}</p>
          {% endif %}
          <div class="qc-footer__service-text qc-text-s">{{ section.settings.service_text }}</div>
        </div>
      {% endif %}
    </div>

    <div class="qc-footer__terminal qc-mono">
      <p class="qc-footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }} · {{ powered_by_link }}
      </p>
      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="qc-footer__payment">
          <span class="qc-visually-hidden">{{ 'general.payment_methods' | t }}</span>
          <ul class="qc-footer__payment-list" role="list" aria-hidden="true">
            {% for type in shop.enabled_payment_types %}
              <li>{{ type | payment_type_svg_tag }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .qc-footer {
    margin-block-start: var(--qc-space-3xl);
    background: var(--qc-ink);
    color: color-mix(in oklab, var(--qc-surface) 84%, var(--qc-ink));
  }

  .qc-footer__inner {
    max-inline-size: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    padding-block: var(--qc-space-3xl) var(--qc-space-l);
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-2xl);
  }

  /* masthead: large wordmark + closing statement, newsletter opposite */
  .qc-footer__masthead {
    display: grid;
    gap: var(--qc-space-2xl);
    padding-block-end: var(--qc-space-2xl);
    border-block-end: var(--qc-line-w) solid color-mix(in oklab, var(--qc-surface) 22%, var(--qc-ink));
  }

  @media (min-width: 900px) {
    .qc-footer__masthead { grid-template-columns: 1.4fr 1fr; align-items: end; }
  }

  .qc-footer__brand { display: flex; flex-direction: column; gap: var(--qc-space-m); align-items: flex-start; }

  .qc-footer__wordmark {
    margin: 0;
    font-family: var(--qc-font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 1.6rem + 3.4vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--qc-surface);
  }

  .qc-footer__closing {
    margin: 0;
    font-size: var(--qc-text-l);
    line-height: 1.35;
    max-inline-size: 32ch;
    color: color-mix(in oklab, var(--qc-surface) 82%, var(--qc-ink));
  }

  .qc-footer .qc-social { display: flex; gap: var(--qc-space-2xs); list-style: none; margin: 0; padding: 0; }
  .qc-footer .qc-social__link { color: color-mix(in oklab, var(--qc-surface) 70%, var(--qc-ink)); min-inline-size: 40px; min-block-size: 40px; display: inline-grid; place-items: center; }
  .qc-footer .qc-social__link:hover { color: var(--qc-surface); }

  /* newsletter, integrated into the grid */
  .qc-footer__signup { display: flex; flex-direction: column; gap: var(--qc-space-s); }
  .qc-footer__signup-label { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: color-mix(in oklab, var(--qc-surface) 64%, var(--qc-ink)); }

  .qc-footer__field {
    display: flex;
    align-items: stretch;
    border-block-end: var(--qc-line-w) solid color-mix(in oklab, var(--qc-surface) 40%, var(--qc-ink));
  }

  .qc-footer__input {
    flex: 1;
    min-inline-size: 0;
    background: transparent;
    border: 0;
    color: var(--qc-surface);
    font: inherit;
    font-size: var(--qc-text-l);
    padding-block: var(--qc-space-s);
    padding-inline: 0;
  }
  .qc-footer__input::placeholder { color: color-mix(in oklab, var(--qc-surface) 48%, var(--qc-ink)); }
  .qc-footer__input:focus { outline: none; }
  .qc-footer__field:focus-within { border-block-end-color: var(--qc-signal); }

  .qc-footer__submit {
    background: transparent;
    border: 0;
    color: var(--qc-surface);
    font-family: var(--qc-font-display);
    font-weight: 600;
    font-size: var(--qc-text-s);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-inline: var(--qc-space-m);
    cursor: pointer;
  }
  .qc-footer__submit:hover { color: var(--qc-signal); }

  .qc-footer__note { margin: 0; font-size: var(--qc-text-s); color: var(--qc-signal); }
  .qc-footer__signup-note { margin: 0; font-size: var(--qc-text-s); color: color-mix(in oklab, var(--qc-surface) 60%, var(--qc-ink)); max-inline-size: 40ch; }

  /* grouped columns + service */
  .qc-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--qc-space-xl);
  }

  @media (min-width: 750px) {
    .qc-footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--qc-space-l); }
  }

  .qc-footer__col-head {
    margin: 0 0 var(--qc-space-m);
    display: flex;
    gap: var(--qc-space-xs);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--qc-surface) 62%, var(--qc-ink));
  }
  .qc-footer__col-index { color: var(--qc-signal); }

  .qc-footer__col-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--qc-space-xs); }
  .qc-footer__col-links a { color: color-mix(in oklab, var(--qc-surface) 86%, var(--qc-ink)); text-decoration: none; font-size: var(--qc-text-s); }
  .qc-footer__col-links a:hover { color: var(--qc-surface); text-decoration: underline; text-underline-offset: 0.2em; }

  .qc-footer__service-text { color: color-mix(in oklab, var(--qc-surface) 74%, var(--qc-ink)); line-height: 1.5; }
  .qc-footer__service-text a { color: var(--qc-surface); }

  /* thin terminal rail */
  .qc-footer__terminal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--qc-space-m);
    padding-block-start: var(--qc-space-l);
    border-block-start: var(--qc-line-w) solid color-mix(in oklab, var(--qc-surface) 22%, var(--qc-ink));
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--qc-surface) 56%, var(--qc-ink));
  }
  .qc-footer__legal { margin: 0; }
  .qc-footer__legal a { color: color-mix(in oklab, var(--qc-surface) 80%, var(--qc-ink)); }
  .qc-footer__payment-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--qc-space-2xs); opacity: 0.85; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "text", "id": "closing", "label": "t:general.footer_closing", "default": "Gear for the water ahead — built to be used hard and kept for seasons." },
    { "type": "header", "content": "t:general.newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "t:general.footer_show_newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "t:general.heading", "default": "Field notes" },
    { "type": "text", "id": "newsletter_text", "label": "t:general.subheading", "default": "New arrivals and field notes. No noise." },
    { "type": "header", "content": "t:general.footer_service" },
    { "type": "text", "id": "service_heading", "label": "t:general.heading", "default": "Service" },
    { "type": "richtext", "id": "service_text", "label": "t:general.text", "default": "<p>Repairs, returns, and honest answers from a person. Reach us any day.</p>" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "t:labels.show_payment_icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:general.footer_column",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Catalog" },
        { "type": "link_list", "id": "menu", "label": "t:labels.menu" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Catalog" } },
        { "type": "menu", "settings": { "heading": "Field notes" } },
        { "type": "menu", "settings": { "heading": "Support" } }
      ]
    }
  ]
}
{% endschema %}
