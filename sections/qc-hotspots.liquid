{% comment %}
  Image hotspots (SPEC-026 §2): one image, up to six product dots
  positioned by X/Y sliders. Dots are native details disclosures —
  keyboard- and no-JS-friendly — opening a mini product card.
  Pure Liquid/CSS.
{% endcomment %}

<div class="qc-hotspots section-padding">
  {% if section.settings.heading != blank %}
    <h2 class="qc-hotspots__heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="qc-hotspots__stage">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'qc-hotspots__image', alt: '', loading: 'lazy', sizes: '(min-width: 990px) 900px, 100vw' }}
    {% else %}
      <div class="qc-hotspots__placeholder"></div>
    {% endif %}

    {% for block in section.blocks %}
      {%- assign spot_product = block.settings.product -%}
      {% if spot_product %}
        <details
          class="qc-hotspot"
          style="--qc-spot-x: {{ block.settings.x }}%; --qc-spot-y: {{ block.settings.y }}%;"
          {{ block.shopify_attributes }}
        >
          <summary class="qc-hotspot__dot">
            <span class="qc-visually-hidden">{{ spot_product.title }}</span>
          </summary>
          <div class="qc-hotspot__card">
            {% if spot_product.featured_image %}
              {{ spot_product.featured_image | image_url: width: 160, height: 160, crop: 'center' | image_tag: class: 'qc-hotspot__thumb', loading: 'lazy', alt: '' }}
            {% endif %}
            <div class="qc-hotspot__info">
              <a class="qc-hotspot__title" href="{{ spot_product.url }}">{{ spot_product.title }}</a>
              <span class="qc-text-s">{% render 'qc-price', item: spot_product %}</span>
            </div>
          </div>
        </details>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .qc-hotspots {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    padding-block: var(--qc-space-xl);
  }

  .qc-hotspots__heading {
    margin: 0;
    font-size: var(--qc-text-2xl);
  }

  .qc-hotspots__stage {
    position: relative;
    overflow: hidden;
    border-radius: var(--qc-radius-surface);
    background: var(--qc-surface-raised);
  }

  .qc-hotspots__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .qc-hotspots__placeholder {
    min-block-size: 320px;
  }

  .qc-hotspot {
    position: absolute;
    inset-inline-start: var(--qc-spot-x, 50%);
    inset-block-start: var(--qc-spot-y, 50%);
    translate: -50% -50%;
  }

  .qc-hotspot__dot {
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: var(--qc-radius-pill);
    background: var(--qc-surface);
    box-shadow: var(--qc-shadow-2);
    border: var(--qc-line-w) solid var(--qc-line-strong);
    cursor: pointer;
    list-style: none;
  }

  .qc-hotspot__dot::-webkit-details-marker {
    display: none;
  }

  .qc-hotspot__dot::after {
    content: '';
    inline-size: 10px;
    block-size: 10px;
    border-radius: var(--qc-radius-pill);
    background: var(--qc-accent);
    transition: transform var(--qc-dur-1) var(--qc-ease);
  }

  .qc-hotspot[open] .qc-hotspot__dot::after {
    transform: rotate(45deg) scale(0.9);
    border-radius: 2px;
  }

  .qc-hotspot__card {
    position: absolute;
    inset-block-start: calc(100% + var(--qc-space-xs));
    inset-inline-start: 50%;
    translate: -50% 0;
    display: flex;
    gap: var(--qc-space-s);
    align-items: center;
    inline-size: max-content;
    max-inline-size: 16rem;
    padding: var(--qc-space-s);
    background: var(--qc-surface);
    border: var(--qc-line-w) solid var(--qc-line);
    border-radius: var(--qc-radius-surface);
    box-shadow: var(--qc-shadow-2);
    z-index: 3;
  }

  .qc-hotspot:nth-last-child(-n + 2) .qc-hotspot__card {
    inset-block-start: auto;
    inset-block-end: calc(100% + var(--qc-space-xs));
  }

  .qc-hotspot__thumb {
    inline-size: 56px;
    block-size: 56px;
    border-radius: var(--qc-radius-control);
    object-fit: cover;
  }

  .qc-hotspot__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .qc-hotspot__title {
    color: var(--qc-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .qc-hotspot__title:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hotspots",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading" },
    { "type": "image_picker", "id": "image", "label": "t:general.image" }
  ],
  "blocks": [
    {
      "type": "spot",
      "name": "t:general.hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "t:general.product" },
        { "type": "range", "id": "x", "label": "t:general.spot_x", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "t:general.spot_y", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.hotspots",
      "blocks": [{ "type": "spot" }, { "type": "spot" }]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
