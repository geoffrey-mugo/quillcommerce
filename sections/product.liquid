        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:general.content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:general.page_content"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "variant_picker",
      "label": "t:general.variant_picker",
      "default": "pills",
      "options": [
        {
          "value": "pills",
          "label": "t:general.variant_picker_pills"
        },
        {
          "value": "dropdown",
          "label": "t:general.variant_picker_dropdown"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "t:general.enable_zoom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_bar",
