{% comment %}
  Password page (SPEC-004 §8): centered card; the storefront_password form
  is Shopify's gate rendered as-is, styled by the foundation system.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="qc-password">
  <div class="qc-password__card">
    <h1>{{ shop.name }}</h1>
    <h2 class="qc-password__subtitle">{{ 'password.title' | t }}</h2>

    {% if shop.password_message != blank %}
      <p class="qc-muted">{{ shop.password_message }}</p>
    {% endif %}

    {% form 'storefront_password', class: 'qc-password__form' %}
      {% if form.errors %}
        <p class="qc-field__error" role="alert">
          {% render 'qc-icon', name: 'alert' %}
          {{ form.errors | default_errors }}
        </p>
      {% endif %}

      <div class="qc-field">
        <label class="qc-field__label" for="password-input">{{ 'password.password' | t }}</label>
        <input class="qc-input" type="password" name="password" id="password-input">
      </div>

      <button type="submit" class="qc-btn qc-btn--primary qc-btn--full">
        {{ 'password.enter' | t }}
      </button>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .qc-password {
    display: grid;
    place-items: center;
    min-block-size: 100svh;
    padding: var(--qc-space-l);
  }

  .qc-password__card {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    inline-size: min(26rem, 100%);
    padding: var(--qc-space-xl);
    border: var(--qc-line-w) solid var(--qc-line);
    border-radius: var(--qc-radius-surface);
    background: var(--qc-surface-raised);
    text-align: center;
  }

  .qc-password__subtitle {
    font-size: var(--qc-text-l);
    color: var(--qc-ink-soft);
  }

  .qc-password__form {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    text-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
