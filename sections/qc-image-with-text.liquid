{% comment %}
  Image with text (SPEC-020 §3): two-column story row, image start or end,
  stacked on small screens. Pure Liquid.
{% endcomment %}

<div class="qc-iwt section-padding qc-iwt--image-{{ section.settings.image_position }}">
  <div class="qc-iwt__media">
    {% if section.settings.image %}
      {% render 'image', image: section.settings.image, class: 'qc-iwt__image', width: 1200, sizes: '(min-width: 750px) 50vw, 100vw' %}
    {% else %}
      <div class="qc-iwt__image qc-iwt__image--empty" aria-hidden="true">
        {% render 'qc-icon', name: 'alert' %}
      </div>
    {% endif %}
  </div>
  <div class="qc-iwt__content">
    {% if section.settings.heading != blank %}
      <h2 class="qc-iwt__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="qc-prose">{{ section.settings.body }}</div>
    {% endif %}
    {% if section.settings.cta_label != blank %}
      <a class="qc-btn qc-btn--outline" href="{{ section.settings.cta_link | default: '#' }}">
        {{ section.settings.cta_label }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .qc-iwt {
    display: grid;
    gap: var(--qc-space-xl);
    padding-block: var(--qc-space-xl);
    align-items: center;
  }

  @media (min-width: 750px) {
    .qc-iwt {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .qc-iwt--image-end .qc-iwt__media {
      order: 2;
    }
  }

  .qc-iwt__image {
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--qc-radius-surface);
    border: var(--qc-line-w) solid var(--qc-line);
  }

  .qc-iwt__image--empty {
    display: grid;
    place-items: center;
    background: var(--qc-surface-raised);
    color: var(--qc-ink-soft);
  }

  .qc-iwt__content {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    align-items: flex-start;
  }

  .qc-iwt__heading {
    margin: 0;
    font-size: var(--qc-text-2xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:general.image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:general.image_position",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "end", "label": "t:general.align_end" }
      ],
      "default": "start"
    },
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Pair text with an image" },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:general.content",
      "default": "<p>Focus on a product, collection, or story. Add details about availability, style, or a review.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "t:general.cta_1_label" },
    { "type": "url", "id": "cta_link", "label": "t:general.cta_1_link" }
  ],
  "presets": [{ "name": "t:general.image_with_text" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
