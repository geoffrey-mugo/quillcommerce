{% comment %}
  Rich text (SPEC-020 §2): heading, prose, optional CTA. Pure Liquid.
{% endcomment %}

<div class="qc-rich-text section-padding qc-rich-text--{{ section.settings.alignment }}">
  {% if section.settings.heading != blank %}
    <h2 class="qc-rich-text__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.body != blank %}
    <div class="qc-prose">{{ section.settings.body }}</div>
  {% endif %}
  {% if section.settings.cta_label != blank %}
    <a class="qc-btn qc-btn--outline" href="{{ section.settings.cta_link | default: '#' }}">
      {{ section.settings.cta_label }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .qc-rich-text {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-m);
    padding-block: var(--qc-space-xl);
    align-items: flex-start;
  }

  .qc-rich-text--center {
    align-items: center;
    text-align: center;
  }

  .qc-rich-text__heading {
    margin: 0;
    font-size: var(--qc-text-2xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rich_text",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:general.heading", "default": "Talk about your brand" },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:general.content",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "t:general.cta_1_label" },
    { "type": "url", "id": "cta_link", "label": "t:general.cta_1_link" },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:general.alignment",
      "options": [
        { "value": "start", "label": "t:general.align_start" },
        { "value": "center", "label": "t:general.align_center" }
      ],
      "default": "start"
    }
  ],
  "presets": [{ "name": "t:general.rich_text" }]
}
{% endschema %}
