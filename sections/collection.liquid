{% comment %}
  Collection page (SPEC-004 §2): title, description, canonical product-card
  grid, empty state, and labeled pagination. Filters/sorting arrive Phase 3.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="qc-collection">
  <header class="qc-collection__header">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="qc-prose qc-muted">{{ collection.description }}</div>
    {% endif %}
  </header>

  {% paginate collection.products by 24 %}
    {% if collection.products_count == 0 %}
      <div class="qc-collection__empty">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="qc-btn qc-btn--primary" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {% else %}
      <ul class="qc-product-grid" role="list">
        {% for product in collection.products %}
          <li>{% render 'qc-product-card', product: product %}</li>
        {% endfor %}
      </ul>

      {% if paginate.pages > 1 %}
        <nav class="qc-pagination" aria-label="{{ 'general.pagination' | t }}">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .qc-collection {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-l);
    padding-block: var(--qc-space-xl);
  }

  .qc-collection__header {
    display: flex;
    flex-direction: column;
    gap: var(--qc-space-xs);
  }

  .qc-collection__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--qc-space-m);
    padding-block: var(--qc-space-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
