{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'qc-foundation.css' | asset_url | stylesheet_tag }}
    {% render 'meta-tags' %}

    {% style %}
      .qc-gift-card {
        min-block-size: 100dvh;
        display: grid;
        place-items: center;
        padding: var(--qc-space-xl) var(--qc-space-m);
      }

      .qc-gift-card__card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: var(--qc-space-m);
        max-inline-size: 26rem;
        padding: var(--qc-space-2xl) var(--qc-space-xl);
        border: var(--qc-line-w) solid var(--qc-line);
        border-radius: var(--qc-radius-surface);
        background: var(--qc-surface-raised);
      }

      .qc-gift-card__balance {
        margin: 0;
        font-size: var(--qc-text-3xl);
      }

      .qc-gift-card__code {
        font-size: var(--qc-text-l);
        font-weight: 600;
        letter-spacing: 0.08em;
        border: var(--qc-line-w) dashed var(--qc-line-strong);
        border-radius: var(--qc-radius-control);
        padding: var(--qc-space-s) var(--qc-space-m);
      }

      .qc-gift-card__qr img {
        border: var(--qc-line-w) solid var(--qc-line);
        border-radius: var(--qc-radius-control);
        padding: var(--qc-space-xs);
        background: #fff;
      }

      @media print {
        .qc-gift-card__actions {
          display: none;
        }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main class="qc-gift-card">
      <div class="qc-gift-card__card">
        <p class="qc-muted">{{ shop.name }}</p>
        <h1 class="qc-gift-card__balance">{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p class="qc-badge qc-badge--warn">{{ 'gift_card.expired' | t }}</p>
        {% elsif gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
          <p class="qc-muted qc-text-s">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
        {% endif %}

        <p>{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="qc-gift-card__code">{{ gift_card.code | format_code }}</p>

        <div class="qc-gift-card__qr" data-gift-card-qr data-identifier="{{ gift_card.qr_identifier }}"></div>

        <div class="qc-gift-card__actions">
          <a class="qc-btn qc-btn--primary" href="{{ shop.url }}">
            {{ 'gift_card.shop_link' | t }}
          </a>
          <button type="button" class="qc-btn qc-btn--outline" data-gift-card-print>
            {{ 'gift_card.print' | t }}
          </button>
        </div>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </div>
    </main>

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script>
      window.addEventListener('DOMContentLoaded', function () {
        var qr = document.querySelector('[data-gift-card-qr]');
        if (qr && window.QRCode && qr.dataset.identifier) {
          new window.QRCode(qr, { text: qr.dataset.identifier, width: 120, height: 120 });
        }
        var print = document.querySelector('[data-gift-card-print]');
        if (print) print.addEventListener('click', function () { window.print(); });
      });
    </script>
  </body>
</html>
